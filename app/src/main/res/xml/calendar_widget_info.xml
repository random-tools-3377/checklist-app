<?xml version="1.0" encoding="utf-8"?>
<!-- The calendar widget. Added, it takes a 4 by 4 space, which shows the month; it can be made smaller (down to 2 by 2: today's agenda) or larger. It redraws itself when goals or ticks change, when the day turns over, and every half hour so "late" stays right. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="120dp"
    android:minResizeHeight="120dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
