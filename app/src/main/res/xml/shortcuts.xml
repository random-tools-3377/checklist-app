<?xml version="1.0" encoding="utf-8"?>
<!--
    The shortcuts shown when the app's icon is held down. Each opens the app with an "open_tab"
    extra (MainActivity.EXTRA_OPEN) that App.kt turns into a screen.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_todo"
        android:shortcutId="new_todo"
        android:shortcutLongLabel="@string/shortcut_todo_long"
        android:shortcutShortLabel="@string/shortcut_todo_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.randomtools3377.checklist.MainActivity"
            android:targetPackage="io.github.randomtools3377.checklist">
            <extra
                android:name="open_tab"
                android:value="new-todo" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_goal"
        android:shortcutId="new_goal"
        android:shortcutLongLabel="@string/shortcut_goal_long"
        android:shortcutShortLabel="@string/shortcut_goal_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.randomtools3377.checklist.MainActivity"
            android:targetPackage="io.github.randomtools3377.checklist">
            <extra
                android:name="open_tab"
                android:value="new-goal" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_plan"
        android:shortcutId="plan"
        android:shortcutLongLabel="@string/shortcut_plan_long"
        android:shortcutShortLabel="@string/shortcut_plan_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.randomtools3377.checklist.MainActivity"
            android:targetPackage="io.github.randomtools3377.checklist">
            <extra
                android:name="open_tab"
                android:value="plan" />
        </intent>
    </shortcut>
    <!-- Quick "Spent" sits among the first four, as most home screens show no more than four. -->
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_spent"
        android:shortcutId="spent"
        android:shortcutLongLabel="@string/shortcut_spent_long"
        android:shortcutShortLabel="@string/shortcut_spent_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.randomtools3377.checklist.MainActivity"
            android:targetPackage="io.github.randomtools3377.checklist">
            <extra
                android:name="open_tab"
                android:value="spent" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_shop"
        android:shortcutId="shop"
        android:shortcutLongLabel="@string/shortcut_shop_long"
        android:shortcutShortLabel="@string/shortcut_shop_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.randomtools3377.checklist.MainActivity"
            android:targetPackage="io.github.randomtools3377.checklist">
            <extra
                android:name="open_tab"
                android:value="shop" />
        </intent>
    </shortcut>
</shortcuts>
